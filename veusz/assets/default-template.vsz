# Synthetic demonstration template; no experimental measurements.
# Self-contained: no imports, linked datasets, or saved-session metadata.
SetCompatLevel(0)
SetData('demo_linear_x', [0, 1, 2, 3, 4])
SetData('demo_log_x', [1, 10, 100, 1000, 10000])
SetData('demo_series_a', [1, 2, 3, 4, 5])
SetData('demo_series_b', [2, 2.5, 3, 3.5, 4])
SetData('demo_baseline_y', [3, 3])
SetData('demo_linear_extent', [0, 4])
SetData('demo_log_extent', [1, 10000])
Add('page', name='demo_page', autoadd=False)
To('demo_page')
Set('width', '7in')
Set('height', '3.5in')
Set('Background/color', '#ffffff')
Set('Background/hide', False)
Add('grid', name='grid', autoadd=False)
To('grid')
Set('rows', 1)
Set('columns', 2)
Set('leftMargin', '0.2cm')
Set('rightMargin', '0.2cm')
Set('topMargin', '0.3cm')
Set('bottomMargin', '0.3cm')
Add('graph', name='demo_linear', autoadd=False)
To('demo_linear')
Add('axis', name='x', autoadd=False)
To('x')
Set('label', 'Synthetic input (a.u.)')
Set('log', False)
Set('min', 0)
Set('max', 4)
To('..')
Add('axis', name='y', autoadd=False)
To('y')
Set('direction', 'vertical')
Set('label', 'Synthetic response (a.u.)')
Set('min', 0)
Set('max', 6)
To('..')
Add('xy', name='demo_a', xData='demo_linear_x', yData='demo_series_a', key='Synthetic A', marker='circle', markerSize='4pt', PlotLine__color='#87c1ca', PlotLine__width='2pt', MarkerFill__color='#186582')
Add('xy', name='demo_b', xData='demo_linear_x', yData='demo_series_b', key='Synthetic B', marker='square', markerSize='4pt', PlotLine__color='#5d6673', PlotLine__width='2pt', MarkerFill__color='#5d6673')
Add('xy', name='demo_baseline', xData='demo_linear_extent', yData='demo_baseline_y', marker='none', PlotLine__color='#ee982b', PlotLine__width='1.5pt', PlotLine__style='dotted')
Add('key', name='legend', horzPosn='left', vertPosn='top', Border__hide=True, Text__size='8pt')
To('..')
Add('graph', name='demo_log', autoadd=False)
To('demo_log')
Add('axis', name='x', autoadd=False)
To('x')
Set('label', 'Synthetic input (a.u.)')
Set('log', True)
Set('min', 1)
Set('max', 10000)
To('..')
Add('axis', name='y', autoadd=False)
To('y')
Set('direction', 'vertical')
Set('label', 'Synthetic response (a.u.)')
Set('min', 0)
Set('max', 6)
To('..')
Add('xy', name='demo_a', xData='demo_log_x', yData='demo_series_a', key='Synthetic A', marker='circle', markerSize='4pt', PlotLine__color='#87c1ca', PlotLine__width='2pt', MarkerFill__color='#186582')
Add('xy', name='demo_b', xData='demo_log_x', yData='demo_series_b', key='Synthetic B', marker='square', markerSize='4pt', PlotLine__color='#5d6673', PlotLine__width='2pt', MarkerFill__color='#5d6673')
Add('xy', name='demo_baseline', xData='demo_log_extent', yData='demo_baseline_y', marker='none', PlotLine__color='#ee982b', PlotLine__width='1.5pt', PlotLine__style='dotted')
Add('key', name='legend', horzPosn='left', vertPosn='top', Border__hide=True, Text__size='8pt')
To('..')
To('..')
To('..')
